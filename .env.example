# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
# REQUIRED in production: random string >= 32 chars (never commit real values)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-secrets-token-hex-32-or-longer

# Database Configuration (MySQL using PyMySQL driver)
# Format: mysql+pymysql://db_user:db_password@db_host:db_port/db_name
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/oplyra

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Generation model (optional). Overrides the built-in default (gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Multi-provider AI Gateway (server-side only — never expose to the browser)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional OpenAI-compatible endpoint (OpenRouter / Together / local)
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_PROVIDER=auto
AI_ENABLE_GEMINI=true
AI_ENABLE_OPENAI=true
AI_ENABLE_ANTHROPIC=true
AI_ENABLE_DEEPSEEK=true
AI_ENABLE_OPENAI_COMPATIBLE=false

# --- Phase 2 Infrastructure ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# Object storage: local (dev) | s3 | gcs | azure
STORAGE_PROVIDER=local
S3_BUCKET=
AWS_REGION=us-east-1
GCS_BUCKET=
AZURE_BLOB_CONTAINER=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
# Vector DB: local (dev/test only) | qdrant | pinecone | weaviate | pgvector
KNOWLEDGE_VECTOR_PROVIDER=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=oplyra_chunks
PINECONE_API_KEY=
PINECONE_HOST=
WEAVIATE_URL=
WEAVIATE_API_KEY=
STRUCTURED_LOGGING=false
LOG_RETENTION_DAYS=90
# Production forbids local vector/storage unless:
# ALLOW_LOCAL_INFRA=true

# Marketing Integrations (Sprint 5A — optional; mock mode when unset)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/callback/google
INTEGRATIONS_MOCK_MODE=true

# --- SMTP / Password Reset Email ---
# Leave MAIL_SERVER empty in local dev to skip real delivery (reset still works;
# check application logs). Configure for staging/production.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@oplyra.com
# MAIL_SUPPRESS_SEND=true   # force skip SMTP (tests set this automatically)

# --- Platform / Internal Admin (staff console at /admin) ---
# Comma-separated customer emails that may open Platform Admin (legacy bridge)
PLATFORM_ADMIN_EMAILS=
# Bootstrap first Internal AdminUser when admin table is empty (DEBUG / first deploy)
INTERNAL_ADMIN_BOOTSTRAP_EMAIL=
INTERNAL_ADMIN_BOOTSTRAP_PASSWORD=
# Optional: re-sync bootstrap password hash on boot (DEBUG only recommended)
# INTERNAL_ADMIN_BOOTSTRAP_RESET_PASSWORD=true
# Optional host allow-list for /admin (comma-separated). Empty = any host.
# ADMIN_HOSTS=
ADMIN_SESSION_HOURS=8
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

